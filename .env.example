SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://user:password@host/database
STORAGE_BACKEND=local
STORAGE_PROVIDER=local

# Production generation path
PIPELINE_MODE=production
GPU_WORKER_URL=https://your-gpu-worker.example.com
GPU_WORKER_TOKEN=change-me
ARTIFACT_ROOT=artifacts/jobs

# AI provider defaults
LLM_PROVIDER=mock
TTS_PROVIDER=qwen3_tts
STT_PROVIDER=mock
VIDEO_PROVIDER=remote_gpu
VLM_PROVIDER=mock
JUDGE_PROVIDER=mock
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# GPU worker settings
VIDEO_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
VIDEO_DEVICE=cuda
ENABLE_TTS=true
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_SPEAKER=Ryan
WORK_ROOT=/workspace/ai-content-factory
HF_HOME=/workspace/hf-cache
